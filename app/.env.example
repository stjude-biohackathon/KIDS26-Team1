# Optional LLM backend for the Insights gene-relevance narrative.
# Copy to .env and fill one in. Priority: OpenRouter > OpenAI > Anthropic > local Ollama.
# The deterministic "Generate narrative" needs no key at all.

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001     # optional override (use a valid id for your account)
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1   # optional override; point this at a Claude-
                                                      # compatible endpoint instead, e.g. Microsoft
                                                      # Azure AI Foundry:
                                                      # https://{your-resource}.services.ai.azure.com/anthropic/v1
                                                      # (then ANTHROPIC_MODEL = your Foundry deployment
                                                      # name, and ANTHROPIC_API_KEY = your Foundry key;
                                                      # same x-api-key header, no other change needed)

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini                      # optional override

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini           # optional override

# OLLAMA_BASE_URL=http://localhost:11434        # local fallback (default)

# STRING_API_KEY=                               # optional; STRING is keyless, used only as a rate-limit fallback
